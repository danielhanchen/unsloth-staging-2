@@ -0,0 +1,756 @@
+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""Apple Silicon (MPS) Qwen-Image-2.1 block as Metal passes: modulation and gated residual each one pass that reads
+its per-row scale / gate from the small parameter rows instead of a ``torch.where``-expanded (batch, seq, dim) copy
+(bit-identical), and q/k RMSNorm + RoPE one pass per tensor (fp32 sum of squares may differ in the last bit); any
+kernel that cannot run (fp16, layout, compiler, failed first-use probe) keeps the stock ops. Per transformer instance, MPS only; CUDA / ROCm / CPU never reach this code.
+Kill switch UNSLOTH_DIFFUSION_Q21_MPS_FUSED=0; per part UNSLOTH_DIFFUSION_Q21_MPS_{MODULATE,RESIDUAL,ROPE}=0."""
+
+from __future__ import annotations
+
+import os
+import threading
+import types
+import weakref
+from typing import Any, Optional
+
+from .diffusion_autoopt.patches import source_digest
+
+FUSED_ENV = "UNSLOTH_DIFFUSION_Q21_MPS_FUSED"
+PART_ENV = "UNSLOTH_DIFFUSION_Q21_MPS_"
+PARTS = ("MODULATE", "RESIDUAL", "ROPE")
+
+_CLASS = "QwenImage21Transformer2DModel"
+# diffusers 0.41.0 / 0.42.1; the block forward below restates 0.42.1's block, the prepare restates its qkv split.
+_FINGERPRINTS: dict[str, frozenset] = {
+    "_qwenimage21_prepare_qkv": frozenset({"574bacc8f355456d", "4c3830595aef56a0"}),
+    "apply_rotary_emb_qwen": frozenset({"ba81dd3fc907c23a"}),
+    "RMSNorm.forward": frozenset({"2633294611ed3bdf"}),
+    "_select_modulation_rows": frozenset({"7e12608919321d40"}),
+    "QwenImage21TransformerBlock.forward": frozenset({"f2cdd58b41ad3441"}),
+    "QwenImage21TransformerBlock._modulate": frozenset({"3bf1998487634f22"}),
+}
+
+_BLOCK_ATTR = "_unsloth_q21_mps_block"
+# Read by diffusion_qwenimage21_math's MPS processor: the per-attention q/k/v prepare.
+PREPARE_ATTR = "_unsloth_q21_mps_prepare"
+
+_LOCK = threading.Lock()
+_LIB: list = [None, False]  # compiled library, failed
+_PROBED: dict = {}  # kernel name -> passed its first-use probe
+_MASKS: dict = {}  # id(mask) -> (weakref, version, prefix_len or None)
+_FREQS: dict = {}  # id(freqs) -> (weakref, real view with storage offset 0)
+STATS = {"block": 0, "modulate_metal": 0, "residual_metal": 0, "rope_metal": 0}
+
+KERNELS = ("q21_modulate", "q21_gated_residual", "q21_qk_norm_rope")
+
+_METAL = r"""
+#include <metal_stdlib>
+using namespace metal;
+
+// bfloat16 travels as its bit pattern: the paravirtual and older GPUs have no bfloat type.
+inline float q21_f(ushort b) { return as_type<float>(uint(b) << 16); }
+inline ushort q21_b(float f) {
+    uint u = as_type<uint>(f);
+    if ((u & 0x7fffffffu) > 0x7f800000u) { return ushort((u >> 16) | 0x40u); }
+    u += 0x7fffu + ((u >> 16) & 1u);  // round to nearest even
+    return ushort(u >> 16);
+}
+
+// Grid (dim / 4, batch * seq): rows before `prefix` read parameter row `zero_row`, the rest their batch row.
+inline uint q21_row(uint token, uint seq, uint prefix, uint zero_row) {
+    uint s = token % seq;
+    return s < prefix ? zero_row : token / seq;
+}
+
+// out = bf16(x * one_plus[row]): diffusers' x * (1 + scale) with the scale selected per row.
+kernel void q21_modulate(
+    device const ushort4* x [[buffer(0)]],
+    device const ushort4* one_plus [[buffer(1)]],
+    device ushort4* out [[buffer(2)]],
+    constant long& dim4_ [[buffer(3)]],
+    constant long& seq_ [[buffer(4)]],
+    constant long& prefix_ [[buffer(5)]],
+    constant long& zero_row_ [[buffer(6)]],
+    uint2 pos [[thread_position_in_grid]]) {
+    uint dim4 = uint(dim4_);
+    if (pos.x >= dim4) { return; }
+    uint row = q21_row(pos.y, uint(seq_), uint(prefix_), uint(zero_row_));
+    uint idx = pos.y * dim4 + pos.x;
+    ushort4 a = x[idx];
+    ushort4 m = one_plus[row * dim4 + pos.x];
+    ushort4 o;
+    for (uint k = 0; k < 4; ++k) { o[k] = q21_b(q21_f(a[k]) * q21_f(m[k])); }
+    out[idx] = o;
+}
+
+// out = bf16(h + bf16(gate[row] * y)): diffusers' h + gate.tanh() * y, gate = tanh of the parameter rows.
+kernel void q21_gated_residual(
+    device const ushort4* h [[buffer(0)]],
+    device const ushort4* y [[buffer(1)]],
+    device const ushort4* gate [[buffer(2)]],
+    device ushort4* out [[buffer(3)]],
+    constant long& dim4_ [[buffer(4)]],
+    constant long& seq_ [[buffer(5)]],
+    constant long& prefix_ [[buffer(6)]],
+    constant long& zero_row_ [[buffer(7)]],
+    uint2 pos [[thread_position_in_grid]]) {
+    uint dim4 = uint(dim4_);
+    if (pos.x >= dim4) { return; }
+    uint row = q21_row(pos.y, uint(seq_), uint(prefix_), uint(zero_row_));
+    uint idx = pos.y * dim4 + pos.x;
+    ushort4 a = h[idx];
+    ushort4 b = y[idx];
+    ushort4 g = gate[row * dim4 + pos.x];
+    ushort4 o;
+    for (uint k = 0; k < 4; ++k) { o[k] = q21_b(q21_f(a[k]) + q21_f(q21_b(q21_f(g[k]) * q21_f(b[k])))); }
+    out[idx] = o;
+}
+
+// One threadgroup per (batch, token, head) row, one thread per rotary pair: diffusers' RMSNorm (fp32 statistics,
+// bf16 after the rsqrt and after the weight) then the complex RoPE multiply in fp32, rounded once.
+kernel void q21_qk_norm_rope(
+    device const ushort2* x [[buffer(0)]],
+    device const ushort2* w [[buffer(1)]],
+    device const float2* freqs [[buffer(2)]],
+    device ushort2* out [[buffer(3)]],
+    constant long& heads_ [[buffer(4)]],
+    constant long& seq_ [[buffer(5)]],
+    constant long& half_ [[buffer(6)]],
+    constant float& eps [[buffer(7)]],
+    uint row [[threadgroup_position_in_grid]],
+    uint tid [[thread_position_in_threadgroup]]) {
+    threadgroup float part[512];
+    uint half_dim = uint(half_);
+    uint s = (row / uint(heads_)) % uint(seq_);
+    uint idx = row * half_dim + tid;
+    ushort2 v = x[idx];
+    float a = q21_f(v.x);
+    float c = q21_f(v.y);
+    part[tid] = a * a + c * c;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint stride = half_dim / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) { part[tid] += part[tid + stride]; }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    float r = precise::rsqrt(part[0] / float(2 * half_dim) + eps);
+    ushort2 wv = w[tid];
+    float na = q21_f(q21_b(q21_f(q21_b(a * r)) * q21_f(wv.x)));
+    float nc = q21_f(q21_b(q21_f(q21_b(c * r)) * q21_f(wv.y)));
+    float2 f = freqs[s * half_dim + tid];
+    out[idx] = ushort2(q21_b(na * f.x - nc * f.y), q21_b(na * f.y + nc * f.x));
+}
+"""
+
+
+def _device_ok(x: Any) -> bool:
+    return x.is_mps
+
+
+def disabled() -> bool:
+    return (os.environ.get(FUSED_ENV) or "").strip().lower() in ("0", "off", "false", "no")
+
+
+def part_enabled(part: str) -> bool:
+    return (os.environ.get(PART_ENV + part) or "").strip().lower() not in (
+        "0",
+        "off",
+        "false",
+        "no",
+    )
+
+
+def original_rmsnorm_forward(mod: Any) -> Any:
+    """diffusers' RMSNorm.forward, also while the eager tier's F.rms_norm forward (installed on every speed tier)
+    holds the class attribute."""
+    import inspect
+
+    forward = getattr(getattr(mod, "RMSNorm", None), "forward", None)
+    try:
+        from . import diffusion_eager_patches as eager
+        if (
+            forward is not None
+            and eager._orig_rmsnorm_forward is not None
+            and getattr(inspect.unwrap(forward), "__code__", None)
+            is eager._rmsnorm_forward.__code__
+        ):
+            return eager._orig_rmsnorm_forward
+    except Exception:  # noqa: BLE001 - no eager tier module: the live attribute
+        pass
+    return forward
+
+
+def why_unsupported(mod: Any) -> Optional[str]:
+    for name, want in _FINGERPRINTS.items():
+        obj = mod
+        if name == "RMSNorm.forward":
+            obj = original_rmsnorm_forward(mod)
+        else:
+            for piece in name.split("."):
+                obj = getattr(obj, piece, None)
+        got = source_digest(obj)
+        if got not in want:
+            return f"{name} differs from the version this was written against ({got})"
+    return None
+
+
+def _library() -> Any:
+    if _LIB[0] is None and not _LIB[1]:
+        with _LOCK:
+            if _LIB[0] is None and not _LIB[1]:
+                try:
+                    import torch
+                    _LIB[0] = torch.mps.compile_shader(_METAL)
+                except Exception:  # noqa: BLE001 - no Metal compiler / old torch: the eager ops
+                    _LIB[1] = True
+    return _LIB[0]
+
+
+# --------------------------------------------------------------------------------------------- row layout
+
+
+def _version(t: Any) -> Any:
+    """The in-place write counter; inference-mode tensors (Studio's renders) have none, and nothing writes into the
+    fast step's per-layout mask, so they key on identity and storage alone."""
+    try:
+        return t._version
+    except RuntimeError:
+        return ("inference", t.data_ptr())
+
+
+def prefix_len(mask: Any, seq: int) -> Optional[int]:
+    """``p`` when ``mask`` is ``[False] * p + [True] * (seq - p)`` (non-target prefix, then target rows); None for
+    any other layout. One host read per mask tensor (the fast step builds one per layout and reuses it)."""
+    import torch
+
+    if not torch.is_tensor(mask) or mask.dtype != torch.bool or tuple(mask.shape) != (seq,):
+        return None
+    key = id(mask)
+    version = _version(mask)
+    hit = _MASKS.get(key)
+    if hit is not None and hit[0]() is mask and hit[1] == version:
+        return hit[2]
+    host = mask.detach().to("cpu")
+    p = int((~host).sum())
+    ok = bool(torch.equal(host, torch.arange(seq) >= p))
+    out = p if ok else None
+    if len(_MASKS) > 64:
+        _MASKS.clear()
+    try:
+        _MASKS[key] = (weakref.ref(mask), version, out)
+    except TypeError:
+        pass
+    return out
+
+
+def _rows_ok(
+    x: Any,
+    rows: Any,
+    masked: bool = True,
+) -> bool:
+    """bf16, contiguous, offset 0 (the kernels index the raw buffers), dim a multiple of 4, rows ``(R, dim)`` with
+    one row per sample plus the t = 0 row when masked."""
+    import torch
+    return (
+        x.dtype == torch.bfloat16
+        and rows.dtype == torch.bfloat16
+        and x.dim() == 3
+        and rows.dim() == 2
+        and x.shape[-1] % 4 == 0
+        and rows.shape[-1] == x.shape[-1]
+        and rows.shape[0] == x.shape[0] + (1 if masked else 0)
+        and x.is_contiguous()
+        and rows.is_contiguous()
+        and x.storage_offset() == 0
+        and rows.storage_offset() == 0
+        and 0 < x.numel() < 2**31
+    )
+
+
+def _grid(x: Any) -> dict:
+    batch, seq, dim = x.shape
+    dim4 = dim // 4
+    return {"threads": (dim4, batch * seq, 1), "group_size": (min(256, dim4), 1, 1)}
+
+
+def modulate(x: Any, one_plus: Any, masked: bool, p: int) -> Optional[Any]:
+    """``x * (1 + scale)`` with ``scale`` selected per row in one Metal pass, bit-identical to diffusers'
+    ``_modulate``; ``one_plus`` is ``1 + scale`` on the parameter rows. None: run the stock ops."""
+    import torch
+
+    if not _rows_ok(x, one_plus, masked) or not _probe("q21_modulate", x.device):
+        return None
+    out = torch.empty_like(x)
+    _library().q21_modulate(
+        x,
+        one_plus,
+        out,
+        x.shape[-1] // 4,
+        x.shape[1],
+        p if masked else 0,
+        one_plus.shape[0] - 1,
+        **_grid(x),
+    )
+    STATS["modulate_metal"] += 1
+    return out
+
+
+def gated_residual(
+    h: Any,
+    y: Any,
+    tanh_gate: Any,
+    masked: bool,
+    p: int,
+    out: Any = None,
+) -> Optional[Any]:
+    """``h + gate.tanh() * y`` with the gate selected per row in one Metal pass, bit-identical to diffusers;
+    ``tanh_gate`` is the tanh of the parameter rows. ``out`` may alias ``h``. None: run the stock ops."""
+    import torch
+
+    if (
+        not _rows_ok(h, tanh_gate, masked)
+        or y.dtype != h.dtype
+        or y.shape != h.shape
+        or not y.is_contiguous()
+        or y.storage_offset() != 0
+        or not _probe("q21_gated_residual", h.device)
+    ):
+        return None
+    if out is None:
+        out = torch.empty_like(h)
+    _library().q21_gated_residual(
+        h,
+        y,
+        tanh_gate,
+        out,
+        h.shape[-1] // 4,
+        h.shape[1],
+        p if masked else 0,
+        tanh_gate.shape[0] - 1,
+        **_grid(h),
+    )
+    STATS["residual_metal"] += 1
+    return out
+
+
+# --------------------------------------------------------------------------------------------- q/k norm + RoPE
+
+
+def _stock_norm(norm: Any) -> bool:
+    """diffusers' RMSNorm forward (or the eager tier's F.rms_norm one, which differs only in rounding)."""
+    import inspect
+
+    forward = getattr(type(norm), "forward", None)
+    want = _STOCK_NORM[0]
+    if want is None or forward is None:
+        return False
+    if forward is want:
+        return True
+    from .diffusion_eager_patches import _rmsnorm_forward
+
+    return getattr(inspect.unwrap(forward), "__code__", None) is _rmsnorm_forward.__code__
+
+
+_STOCK_NORM: list = [None]
+
+
+def _freqs_real(freqs: Any) -> Any:
+    import torch
+
+    key = id(freqs)
+    hit = _FREQS.get(key)
+    if hit is not None and hit[0]() is freqs:
+        return hit[1]
+    real = torch.view_as_real(freqs)
+    if real.storage_offset() != 0 or not real.is_contiguous():
+        real = real.clone(memory_format = torch.contiguous_format)
+    if len(_FREQS) > 16:
+        _FREQS.clear()
+    try:
+        _FREQS[key] = (weakref.ref(freqs), real)
+    except TypeError:
+        pass
+    return real
+
+
+def _rope_ok(x: Any, norm: Any, freqs: Any) -> bool:
+    import torch
+
+    if (
+        x.dim() != 4
+        or x.dtype != torch.bfloat16
+        or not x.is_contiguous()
+        or x.storage_offset() != 0
+    ):
+        return False
+    dim = x.shape[-1]
+    weight = getattr(norm, "weight", None)
+    return (
+        dim == 128  # the probed geometry: one 64-thread threadgroup per row
+        and 0 < x.numel() < 2**31
+        and _stock_norm(norm)
+        and getattr(norm, "bias", None) is None
+        and weight is not None
+        and weight.dtype == x.dtype
+        and weight.device == x.device
+        and tuple(weight.shape) == (dim,)
+        and weight.is_contiguous()
+        and weight.storage_offset() == 0
+        and torch.is_tensor(freqs)
+        and freqs.dtype == torch.complex64
+        and freqs.device == x.device
+        and freqs.dim() == 2
+        and freqs.shape[0] == x.shape[1]
+        and freqs.shape[1] * 2 == dim
+    )
+
+
+def norm_rope(x: Any, norm: Any, freqs: Any) -> Optional[Any]:
+    """``apply_rotary_emb_qwen(norm(x), freqs, use_real=False)`` in one Metal pass, or None to run the stock pair."""
+    import torch
+
+    if not _rope_ok(x, norm, freqs) or not _probe("q21_qk_norm_rope", x.device):
+        return None
+    batch, seq, heads, dim = x.shape
+    out = torch.empty_like(x)
+    half = dim // 2
+    _library().q21_qk_norm_rope(
+        x,
+        norm.weight,
+        _freqs_real(freqs),
+        out,
+        heads,
+        seq,
+        half,
+        float(norm.eps),
+        threads = batch * seq * heads * half,
+        group_size = half,
+    )
+    STATS["rope_metal"] += 1
+    return out
+
+
+def _stock_norm_rope(mod: Any, x: Any, norm: Any, freqs: Any, dtype: Any) -> Any:
+    return mod.apply_rotary_emb_qwen(norm(x).to(dtype), freqs, use_real = False)
+
+
+def make_prepare(mod: Any) -> Any:
+    stock = mod._qwenimage21_prepare_qkv
+
+    def prepare(attn, hidden_states, rotary_emb, layer_cache, kv_cache_mode, cache_write_slice):
+        import torch
+
+        if rotary_emb is None or torch.is_grad_enabled() or not _device_ok(hidden_states):
+            return stock(
+                attn, hidden_states, rotary_emb, layer_cache, kv_cache_mode, cache_write_slice
+            )
+        query = attn.to_q(hidden_states)
+        key = attn.to_k(hidden_states)
+        value = attn.to_v(hidden_states)
+        head_dim = attn.inner_dim // attn.heads
+        query = query.unflatten(-1, (-1, head_dim))
+        key = key.unflatten(-1, (-1, head_dim))
+        value = value.unflatten(-1, (-1, head_dim))
+        fused_q = norm_rope(query, attn.norm_q, rotary_emb) if query.dtype == value.dtype else None
+        fused_k = norm_rope(key, attn.norm_k, rotary_emb) if fused_q is not None else None
+        query = (
+            fused_q
+            if fused_q is not None
+            else _stock_norm_rope(mod, query, attn.norm_q, rotary_emb, value.dtype)
+        )
+        key = (
+            fused_k
+            if fused_k is not None
+            else _stock_norm_rope(mod, key, attn.norm_k, rotary_emb, value.dtype)
+        )
+
+        if layer_cache is not None:
+            if kv_cache_mode == "extract" and cache_write_slice is not None:
+                layer_cache.store(
+                    key[:, cache_write_slice].clone(), value[:, cache_write_slice].clone()
+                )
+            elif kv_cache_mode == "cached":
+                cached_k, cached_v = layer_cache.get()
+                key = torch.cat([cached_k, key], dim = 1)
+                value = torch.cat([cached_v, value], dim = 1)
+        return query, key, value, query.shape[1]
+
+    prepare.__unsloth_q21_mps__ = True
+    return prepare
+
+
+# --------------------------------------------------------------------------------------------- probes
+
+
+def _probe(name: str, device: Any) -> bool:
+    """First use of a kernel compares it with the eager math on a small input; a mismatch disables that kernel."""
+    hit = _PROBED.get(name)
+    if hit is not None:
+        return hit
+    ok = False
+    try:
+        if _library() is not None:
+            ok = _run_probe(name, device)
+    except Exception:  # noqa: BLE001 - a Metal / driver failure keeps the eager ops
+        ok = False
+    _PROBED[name] = ok
+    return ok
+
+
+def qmod_select(params: Any, mask: Any) -> Any:
+    return _module()._select_modulation_rows(params, mask)
+
+
+def _run_probe(name: str, device: Any) -> bool:
+    import torch
+
+    g = torch.Generator().manual_seed(7)
+    if name in ("q21_gated_residual", "q21_modulate"):
+        # 2 batch rows + the t = 0 row, 5 prefix rows: covers the row select and a partial last threadgroup.
+        h = torch.randn(2, 37, 1032, generator = g).to(device, torch.bfloat16)
+        y = torch.randn(2, 37, 1032, generator = g).to(device, torch.bfloat16)
+        rows = torch.randn(3, 1032, generator = g).to(device, torch.bfloat16)
+        mask = torch.arange(37, device = device) >= 5
+        out = torch.empty_like(h)
+        if name == "q21_modulate":
+            one_plus = 1 + rows
+            _library().q21_modulate(h, one_plus, out, 258, 37, 5, 2, **_grid(h))
+            want = h * (1 + qmod_select(rows, mask))
+        else:
+            gate = rows.tanh()
+            _library().q21_gated_residual(h, y, gate, out, 258, 37, 5, 2, **_grid(h))
+            want = h + qmod_select(rows, mask).tanh() * y
+        return bool(torch.equal(out, want))
+    if name == "q21_qk_norm_rope":
+        from diffusers.models.normalization import RMSNorm
+        from diffusers.models.transformers.transformer_qwenimage21 import apply_rotary_emb_qwen
+
+        x = torch.randn(1, 9, 3, 128, generator = g).to(device, torch.bfloat16)
+        norm = RMSNorm(128, eps = 1e-6).to(device, torch.bfloat16)
+        with torch.no_grad():
+            norm.weight.copy_(1 + 0.1 * torch.randn(128, generator = g))
+        angles = torch.randn(9, 64, generator = g)
+        freqs = torch.polar(torch.ones_like(angles), angles).to(device)
+        out = torch.empty_like(x)
+        _library().q21_qk_norm_rope(
+            x,
+            norm.weight,
+            torch.view_as_real(freqs).contiguous(),
+            out,
+            3,
+            9,
+            64,
+            1e-6,
+            threads = 9 * 3 * 64,
+            group_size = 64,  # one threadgroup per row
+        )
+        with torch.no_grad():
+            want = apply_rotary_emb_qwen(norm(x).to(x.dtype), freqs, use_real = False)
+        # fp32 sum-of-squares order may differ in the last bit: one bf16 step of the output's magnitude.
+        return bool(((out.float() - want.float()).abs() <= want.float().abs() * 2**-7 + 1e-6).all())
+    return False
+
+
+# --------------------------------------------------------------------------------------------- block forward
+
+
+def _block_forward(
+    self,
+    hidden_states,
+    modulation,
+    rotary_emb = None,
+    attention_mask = None,
+    target_token_mask = None,
+    layer_cache = None,
+    kv_cache_mode = None,
+    cache_write_slice = None,
+    segments = None,
+    key_valid = None,
+):
+    import torch
+
+    stock = type(self).forward
+    flags = self.__dict__.get(_BLOCK_ATTR)
+    masked = target_token_mask is not None
+    eligible = not (
+        flags is None
+        or torch.is_grad_enabled()
+        or torch.compiler.is_compiling()
+        or not _device_ok(hidden_states)
+        or hidden_states.dim() != 3
+        or modulation.dim() != 2
+        or modulation.shape[0] != hidden_states.shape[0] + (1 if masked else 0)
+    )
+    # The host read of the mask layout only once everything else qualifies.
+    p = (
+        (prefix_len(target_token_mask, hidden_states.shape[1]) if masked else 0)
+        if eligible
+        else None
+    )
+    if p is None:
+        return stock(
+            self,
+            hidden_states,
+            modulation,
+            rotary_emb,
+            attention_mask,
+            target_token_mask,
+            layer_cache,
+            kv_cache_mode,
+            cache_write_slice,
+            segments,
+            key_valid,
+        )
+    use_mod, use_res = flags
+    STATS["block"] += 1
+    mod1, mod2 = modulation.chunk(2, dim = -1)
+    scale1, gate1 = mod1.chunk(2, dim = -1)
+    scale2, gate2 = mod2.chunk(2, dim = -1)
+
+    def rows(params):
+        return _module()._select_modulation_rows(params, target_token_mask)
+
+    def _mod(x, scale):
+        out = modulate(x, 1 + scale, masked, p) if use_mod else None
+        return x * (1 + rows(scale)) if out is None else out
+
+    def _res(
+        h,
+        y,
+        gate,
+        out = None,
+    ):
+        res = gated_residual(h, y, gate.tanh(), masked, p, out = out) if use_res else None
+        return h + rows(gate).tanh() * y if res is None else res
+
+    attn_output = self.attn(
+        hidden_states = _mod(self.img_norm1(hidden_states), scale1),
+        attention_mask = attention_mask,
+        rotary_emb = rotary_emb,
+        layer_cache = layer_cache,
+        kv_cache_mode = kv_cache_mode,
+        cache_write_slice = cache_write_slice,
+        segments = segments,
+        key_valid = key_valid,
+    )
+    hidden_states = _res(hidden_states, attn_output, gate1)
+    mlp_output = self.img_mlp(_mod(self.img_norm2(hidden_states), scale2))
+    # Either first residual path returns a fresh tensor this block owns, so the second may write over it.
+    hidden_states = _res(hidden_states, mlp_output, gate2, out = hidden_states)
+
+    if hidden_states.dtype == torch.float16:
+        hidden_states = hidden_states.clip(-65504, 65504)
+    return hidden_states
+
+
+_block_forward.__unsloth_q21_mps__ = True
+
+
+def _module() -> Any:
+    from diffusers.models.transformers import transformer_qwenimage21 as mod
+    return mod
+
+
+def installed(transformer: Any) -> bool:
+    blocks = getattr(transformer, "transformer_blocks", None) or ()
+    return any(_BLOCK_ATTR in getattr(b, "__dict__", {}) for b in blocks)
+
+
+def uninstall(transformer: Any) -> None:
+    for block in getattr(transformer, "transformer_blocks", None) or ():
+        d = getattr(block, "__dict__", {})
+        d.pop(_BLOCK_ATTR, None)
+        if getattr(d.get("forward"), "__unsloth_q21_mps__", False):
+            d.pop("forward", None)
+        attn = getattr(block, "attn", None)
+        if attn is not None:
+            attn.__dict__.pop(PREPARE_ATTR, None)
+
+
+def _on_mps(transformer: Any) -> bool:
+    try:
+        return _device_ok(next(transformer.parameters()))
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def _target_is_mps(device: Any, transformer: Any) -> bool:
+    """The load's target device (the pipe is still on CPU at STAGE_LOAD, placement comes later); without one, where
+    the denoiser's weights are."""
+    if device is None:
+        return _on_mps(transformer)
+    try:
+        import torch
+        return torch.device(device).type == "mps"
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def install_for_pipe(
+    pipe: Any,
+    logger: Any = None,
+    explicit_off: bool = False,
+    device: Any = None,
+) -> bool:
+    """Per transformer instance (dies with the pipe); an explicit speed ``off`` load keeps the stock block.
+    ``device``: the load's target device; each call still checks its activations are on MPS."""
+    transformer = getattr(pipe, "transformer", None)
+    if type(transformer).__name__ != _CLASS:
+        return False
+    if explicit_off or disabled() or not _target_is_mps(device, transformer):
+        uninstall(transformer)
+        return False
+    try:
+        mod = _module()
+    except Exception:  # noqa: BLE001 - diffusers without Qwen-Image 2.1
+        return False
+    why = why_unsupported(mod)
+    if why is not None:
+        if logger is not None:
+            logger.info("diffusion.q21_mps: stock block kept: %s", why)
+        return False
+    _STOCK_NORM[0] = original_rmsnorm_forward(mod)
+    cls = mod.QwenImage21TransformerBlock
+    # Compile and probe now, at load, not inside the first render; a failed probe keeps that part stock.
+    import torch
+
+    probes = {name: _probe(name, torch.device("mps")) for name in KERNELS}
+    flags = (
+        part_enabled("MODULATE") and probes["q21_modulate"],
+        part_enabled("RESIDUAL") and probes["q21_gated_residual"],
+    )
+    rope = part_enabled("ROPE") and probes["q21_qk_norm_rope"]
+    if not (flags[0] or flags[1] or rope):
+        uninstall(transformer)
+        if logger is not None:
+            logger.info(
+                "diffusion.q21_mps: stock block kept: Metal kernels unavailable (%s)", probes
+            )
+        return False
+    prepare = make_prepare(mod) if rope else None
+    count = 0
+    for block in getattr(transformer, "transformer_blocks", None) or ():
+        current = block.__dict__.get("forward")
+        # Another wrapper (offload hooks) owns the instance forward: leave that block stock.
+        if type(block) is not cls or (
+            current is not None and not getattr(current, "__unsloth_q21_mps__", False)
+        ):
+            continue
+        block.__dict__[_BLOCK_ATTR] = flags
+        block.__dict__["forward"] = types.MethodType(_block_forward, block)
+        attn = getattr(block, "attn", None)
+        if attn is not None:
+            if prepare is not None:
+                attn.__dict__[PREPARE_ATTR] = prepare
+            else:
+                attn.__dict__.pop(PREPARE_ATTR, None)
+        count += 1
+    if logger is not None and count:
+        logger.info(
+            "diffusion.q21_mps: %d blocks run row-level modulation%s%s",
+            count,
+            ", one-pass gated residual" if flags[1] else "",
+            ", one-pass q/k RMSNorm + RoPE" if rope else "",
+        )
+    return count > 0
