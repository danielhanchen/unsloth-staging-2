+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""Opt-in TeaCache step reuse for the undistilled Z-Image base on the MLX engine.
+
+Port of the Z-Image base gate from mlx-teacache (https://github.com/IonDen/mlx-teacache, Apache-2.0, Copyright
+IonDen): the gate signal is the first main layer's residual, its step-to-step relative L1 is priced by a calibrated
+polynomial and accumulated, and while the sum stays under the threshold the other 29 main layers are replaced by the
+residual cached on the last computed step (one per CFG branch). The coefficients and calibrated range are theirs,
+verbatim (variants/z_image_base/config.py, 2026-05-31 calibration: 50 steps, CFG 4, 512x512).
+
+Opt-in: ``transformer_cache="fbcache"`` at load (the request's first-block cache), or
+``UNSLOTH_DIFFUSION_MLX_TEACACHE=1`` / a threshold. Never on a distilled model (Turbo skips ~nothing) or below
+``MIN_STEPS``. The forward re-walks mflux's ``ZImageTransformer.__call__`` (identical in mflux 0.22 and 0.24); a
+transformer missing any piece of it runs unwrapped. mlx is imported lazily.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+from dataclasses import dataclass, field
+from typing import Any, Optional
+
+ENV = "UNSLOTH_DIFFUSION_MLX_TEACACHE"
+MODE = "teacache"
+# The request value that opts in: diffusers' first-block cache is the same idea (gate on the first block's residual).
+REQUEST_MODES = ("fbcache", "teacache")
+DEFAULT_THRESHOLD = 0.12
+# == diffusion_cache.FBCACHE_MIN_STEPS: fewer steps leave nothing to reuse.
+MIN_STEPS = 20
+MAX_CONSECUTIVE_SKIPS = 8
+SKIP_FIRST = 1
+SKIP_LAST = 1
+COEFFICIENTS = (-898.9907628349583, 367.7086118008557, -45.41511572598643, 3.95114319842774, 0.0)
+CALIBRATED_RANGE = (0.027887196237753466, 0.25914120883567665)
+
+_REQUIRED = (
+    "t_embedder",
+    "t_scale",
+    "patch_size",
+    "f_patch_size",
+    "out_channels",
+    "all_x_embedder",
+    "all_final_layer",
+    "x_pad_token",
+    "cap_pad_token",
+    "cap_embedder",
+    "noise_refiner",
+    "context_refiner",
+    "layers",
+    "rope_embedder",
+)
+
+
+def requested_threshold(
+    transformer_cache: Optional[str],
+    threshold: Optional[float],
+    env: Optional[dict] = None,
+) -> Optional[float]:
+    """The threshold the load asked for, or None. The env wins: ``0`` / ``off`` disables, ``1`` / ``on`` takes the
+    default, a positive number is the threshold."""
+    raw = str((os.environ if env is None else env).get(ENV, "") or "").strip().lower()
+    if raw in ("0", "off", "false", "no"):
+        return None
+    if raw in ("1", "on", "true", "yes"):
+        return float(threshold) if threshold and threshold > 0 else DEFAULT_THRESHOLD
+    if raw:
+        try:
+            value = float(raw)
+        except ValueError:
+            value = 0.0
+        return value if value > 0 else None
+    mode = str(transformer_cache or "").strip().lower()
+    if mode not in REQUEST_MODES:
+        return None
+    return float(threshold) if threshold and threshold > 0 else DEFAULT_THRESHOLD
+
+
+def applies(model: Any, steps: int, threshold: Optional[float]) -> bool:
+    """Undistilled (guidance-capable) Z-Image at ``MIN_STEPS``+ steps whose transformer matches the re-walk."""
+    if not threshold or threshold <= 0 or int(steps) < MIN_STEPS:
+        return False
+    if not bool(getattr(getattr(model, "model_config", None), "supports_guidance", False)):
+        return False
+    transformer = getattr(model, "transformer", None)
+    kind = type(transformer)
+    if not all(hasattr(transformer, name) for name in _REQUIRED):
+        return False
+    return callable(getattr(kind, "_patchify", None)) and callable(
+        getattr(kind, "_unpatchify", None)
+    )
+
+
+def _poly(x: float) -> float:
+    c4, c3, c2, c1, c0 = COEFFICIENTS
+    return ((((c4 * x) + c3) * x + c2) * x + c1) * x + c0
+
+
+@dataclass
+class TeaCacheStats:
+    threshold: float
+    steps: int
+    computed: int = 0
+    skipped: int = 0
+    decisions: list = field(default_factory = list)
+
+    def as_dict(self) -> dict[str, Any]:
+        return {
+            "mode": MODE,
+            "threshold": self.threshold,
+            "steps": self.steps,
+            "computed": self.computed,
+            "skipped": self.skipped,
+        }
+
+
+class _Gate:
+    """Accumulated rescaled rel-L1 of the gate signal; decides per step whether to run the main layers."""
+
+    def __init__(self, threshold: float, steps: int) -> None:
+        self.threshold = float(threshold)
+        self.steps = int(steps)
+        self.step = 0
+        self.previous = None
+        self.accumulated = 0.0
+        self.consecutive = 0
+        self.residual = None
+        self.residual_neg = None
+        # Forced steps (first / last) compute without refreshing the cache, as upstream.
+        self.update = False
+
+    def decide(self, mx: Any, signal: Any) -> bool:
+        """True = compute. Advances the step counter."""
+        index = self.step
+        self.step += 1
+        previous, self.previous = self.previous, signal
+        self.update = False
+        if index < SKIP_FIRST or index >= self.steps - SKIP_LAST:
+            return True
+        self.update = True
+        if previous is None or self.residual is None:
+            return True
+        num = mx.mean(mx.abs(signal - previous).astype(mx.float32))
+        den = mx.mean(mx.abs(previous).astype(mx.float32))
+        mx.eval(num, den)
+        rel = float(num.item()) / max(float(den.item()), 1e-12)
+        if not math.isfinite(rel):
+            self.update = False
+            self.residual = self.residual_neg = None
+            self.accumulated = 0.0
+            self.consecutive = 0
+            return True
+        lo, hi = CALIBRATED_RANGE
+        total = self.accumulated + max(0.0, _poly(min(max(rel, lo), hi)))
+        if rel <= hi and total < self.threshold and self.consecutive < MAX_CONSECUTIVE_SKIPS:
+            self.accumulated = total
+            self.consecutive += 1
+            return False
+        self.accumulated = 0.0
+        self.consecutive = 0
+        return True
+
+
+def _t_emb(mx: Any, transformer: Any, timestep: Any) -> Any:
+    if timestep.ndim == 0:
+        timestep = timestep.reshape((1,))
+    t_emb = transformer.t_embedder(timestep.astype(mx.float32) * transformer.t_scale)
+    stream = getattr(type(transformer), "stream_t_emb", None)
+    if callable(stream):
+        t_emb = stream(t_emb, getattr(transformer, "float32", False))
+    return t_emb
+
+
+def _prelude(mx: Any, transformer: Any, latents: Any, t_emb: Any, cap_feats: Any) -> tuple:
+    kind = type(transformer)
+    key = f"{transformer.patch_size}-{transformer.f_patch_size}"
+    x_emb, cap_emb, x_size, x_pos, cap_pos, x_pad, cap_pad = kind._patchify(
+        image = latents,
+        cap_feats = cap_feats,
+        patch_size = transformer.patch_size,
+        f_patch_size = transformer.f_patch_size,
+    )
+    x_emb = transformer.all_x_embedder[key](x_emb)
+    x_emb = mx.where(x_pad[:, None], transformer.x_pad_token, x_emb)
+    x_freqs = transformer.rope_embedder(x_pos)
+    x_mask = mx.ones((1, x_emb.shape[0]), dtype = mx.bool_)
+    x_emb = mx.expand_dims(x_emb, axis = 0)
+    for layer in transformer.noise_refiner:
+        x_emb = layer(x = x_emb, attn_mask = x_mask, freqs_cis = x_freqs, t_emb = t_emb)
+    cap_emb = transformer.cap_embedder[1](transformer.cap_embedder[0](cap_emb))
+    cap_emb = mx.where(cap_pad[:, None], transformer.cap_pad_token, cap_emb)
+    cap_freqs = transformer.rope_embedder(cap_pos)
+    cap_mask = mx.ones((1, cap_emb.shape[0]), dtype = mx.bool_)
+    cap_emb = mx.expand_dims(cap_emb, axis = 0)
+    for layer in transformer.context_refiner:
+        cap_emb = layer(x = cap_emb, attn_mask = cap_mask, freqs_cis = cap_freqs)
+    unified = mx.concatenate([x_emb, cap_emb], axis = 1)
+    freqs = mx.concatenate([x_freqs, cap_freqs], axis = 0)
+    mask = mx.ones((1, unified.shape[1]), dtype = mx.bool_)
+    return unified, freqs, mask, x_emb.shape[1], x_size
+
+
+def _tail(transformer: Any, main_out: Any, t_emb: Any, x_len: int, x_size: Any) -> Any:
+    key = f"{transformer.patch_size}-{transformer.f_patch_size}"
+    final = transformer.all_final_layer[key](main_out, t_emb)
+    output = type(transformer)._unpatchify(
+        x = final[0, :x_len],
+        size = x_size,
+        patch_size = transformer.patch_size,
+        f_patch_size = transformer.f_patch_size,
+        out_channels = transformer.out_channels,
+    )
+    return -output
+
+
+def make_predict_factory(threshold: float, steps: int, stats: TeaCacheStats) -> Any:
+    """A replacement for ``ZImage._predict``: ``predict = model._predict(model.transformer)`` runs once per
+    generation, so each call starts a fresh gate. Eager (the gate reads a scalar every step)."""
+
+    def factory(transformer: Any) -> Any:
+        import mlx.core as mx
+
+        gate = _Gate(threshold, steps)
+
+        def predict(latents, timestep, sigmas, text_encodings, negative_encodings, guidance):  # noqa: ARG001
+            t_emb = _t_emb(mx, transformer, timestep)
+            branches = [text_encodings] + (
+                [negative_encodings] if negative_encodings is not None else []
+            )
+            preludes = [_prelude(mx, transformer, latents, t_emb, cap) for cap in branches]
+            layers = transformer.layers
+            unified, freqs, mask, _x_len, _x_size = preludes[0]
+            first = layers[0](x = unified, attn_mask = mask, freqs_cis = freqs, t_emb = t_emb)
+            compute = gate.decide(mx, first - unified)
+            outs = []
+            for index, (unified, freqs, mask, x_len, x_size) in enumerate(preludes):
+                if compute:
+                    h = (
+                        first
+                        if index == 0
+                        else layers[0](x = unified, attn_mask = mask, freqs_cis = freqs, t_emb = t_emb)
+                    )
+                    for layer in layers[1:]:
+                        h = layer(x = h, attn_mask = mask, freqs_cis = freqs, t_emb = t_emb)
+                    if gate.update and index == 0:
+                        gate.residual = h - unified
+                    elif gate.update:
+                        gate.residual_neg = h - unified
+                else:
+                    h = unified + (gate.residual if index == 0 else gate.residual_neg)
+                outs.append(_tail(transformer, h, t_emb, x_len, x_size))
+            stats.decisions.append(bool(compute))
+            if compute:
+                stats.computed += 1
+            else:
+                stats.skipped += 1
+            if len(outs) == 1:
+                return outs[0]
+            noise, negative = outs
+            return noise + guidance * (noise - negative)
+
+        return predict
+
+    return factory
+
+
+class engaged:
+    """Context manager: install the gated ``_predict`` on ``model`` for one generation, restore it after."""
+
+    def __init__(self, model: Any, threshold: float, steps: int) -> None:
+        self.model = model
+        self.stats = TeaCacheStats(threshold = float(threshold), steps = int(steps))
+        self._had_instance = False
+        self._previous = None
+
+    def __enter__(self) -> TeaCacheStats:
+        instance = getattr(self.model, "__dict__", {})
+        self._had_instance = "_predict" in instance
+        self._previous = instance.get("_predict")
+        self.model._predict = make_predict_factory(
+            self.stats.threshold, self.stats.steps, self.stats
+        )
+        return self.stats
+
+    def __exit__(self, *exc: Any) -> None:
+        if self._had_instance:
+            self.model._predict = self._previous
+        else:
+            try:
+                del self.model._predict
+            except AttributeError:
+                pass
