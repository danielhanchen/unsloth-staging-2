+def test_rewalk_matches_mflux_predict_bit_for_bit():
+    mx = _mx()
+    transformer_mod = pytest.importorskip(
+        "mflux.models.z_image.model.z_image_transformer.transformer"
+    )
+    z_image = pytest.importorskip("mflux.models.z_image.variants.z_image")
+    from mlx.utils import tree_map
+
+    mx.random.seed(0)
+    transformer = transformer_mod.ZImageTransformer(
+        dim = 128, n_layers = 4, n_heads = 4, cap_feat_dim = 64, axes_dims = [8, 12, 12]
+    )
+    transformer.update(
+        tree_map(
+            lambda a: (mx.random.normal(a.shape) * 0.05).astype(a.dtype),
+            transformer.parameters(),
+        )
+    )
+    mx.eval(transformer.parameters())
+    latents = mx.random.normal((16, 1, 16, 16))
+    cap = mx.random.normal((20, 64))
+    neg = mx.random.normal((7, 64))
+    sigmas = mx.linspace(1, 0, 11)
+    # mflux compiles its predict off M1/M2; compare against the eager closure it builds on M1/M2.
+    stock_factory = z_image.ZImage._predict
+    monkey = pytest.MonkeyPatch()
+    monkey.setattr(z_image.AppleSiliconUtil, "is_m1_or_m2", staticmethod(lambda: True))
+    try:
+        stock = stock_factory(transformer)
+    finally:
+        monkey.undo()
+    stats = tc.TeaCacheStats(threshold = 0.12, steps = 10)
+    ours = tc.make_predict_factory(0.12, 10, stats)(transformer)
+    for t in range(10):
+        timestep = (1 - sigmas[t]).reshape((1,))
+        a = stock(latents, timestep, sigmas, cap, neg, 4.0)
+        b = ours(latents, timestep, sigmas, cap, neg, 4.0)
+        mx.eval(a, b)
+        if stats.decisions[-1]:
+            assert mx.array_equal(a, b).item(), t
+    assert stats.computed + stats.skipped == 10
+    assert stats.decisions[0] and stats.decisions[-1]
