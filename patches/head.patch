+def test_engaged_restores_the_class_predict():
+    class _M:
+        @staticmethod
+        def _predict(transformer):
+            return "stock"
+
+    model = _M()
+    with tc.engaged(model, 0.12, 50) as stats:
+        assert model._predict is not _M._predict
+        assert stats.threshold == 0.12
+    assert "_predict" not in model.__dict__
+    assert model._predict(None) == "stock"
