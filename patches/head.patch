+# SPDX-License-Identifier: AGPL-3.0-only
+# Copyright 2026-present the Unsloth AI Inc. team. All rights reserved. See /studio/LICENSE.AGPL-3.0
+
+"""Opt-in TeaCache for Z-Image base on the MLX engine: opt-in rules, wiring, and (with real mlx + mflux) that the
+re-walked forward computes exactly what mflux's own ``_predict`` does."""
+
+from __future__ import annotations
+
+import pytest
+
+from core.inference import mlx_diffusion_teacache as tc
+
+
+@pytest.mark.parametrize(
+    "request_mode, threshold, env, expected",
+    [
+        (None, None, {}, None),
+        ("off", None, {}, None),
+        ("static", None, {}, None),
+        ("auto", None, {}, None),
+        ("fbcache", None, {}, tc.DEFAULT_THRESHOLD),
+        ("FBCache", 0.2, {}, 0.2),
+        ("teacache", 0, {}, tc.DEFAULT_THRESHOLD),
+        ("fbcache", None, {tc.ENV: "0"}, None),
+        (None, None, {tc.ENV: "1"}, tc.DEFAULT_THRESHOLD),
+        (None, 0.3, {tc.ENV: "on"}, 0.3),
+        (None, None, {tc.ENV: "0.05"}, 0.05),
+        (None, None, {tc.ENV: "junk"}, None),
+    ],
+)
+def test_requested_threshold(request_mode, threshold, env, expected):
+    assert tc.requested_threshold(request_mode, threshold, env = env) == expected
+
+
+class _Transformer:
+    @staticmethod
+    def _patchify(**_):
+        raise AssertionError
+
+    @staticmethod
+    def _unpatchify(**_):
+        raise AssertionError
+
+
+for _name in tc._REQUIRED:
+    setattr(_Transformer, _name, None)
+
+
+class _Config:
+    def __init__(self, guidance):
+        self.supports_guidance = guidance
+
+
+class _Model:
+    def __init__(
+        self,
+        guidance = True,
+        transformer = None,
+    ):
+        self.model_config = _Config(guidance)
+        self.transformer = _Transformer() if transformer is None else transformer
+
+
+def test_applies_only_to_the_undistilled_model_at_enough_steps():
+    assert tc.applies(_Model(), 50, 0.12)
+    assert tc.applies(_Model(), tc.MIN_STEPS, 0.12)
+    assert not tc.applies(_Model(), tc.MIN_STEPS - 1, 0.12)
+    # Turbo (distilled, no guidance) never engages.
+    assert not tc.applies(_Model(guidance = False), 50, 0.12)
+    assert not tc.applies(_Model(), 50, None)
+    assert not tc.applies(_Model(), 50, 0.0)
+    # A transformer the re-walk does not recognise runs unwrapped.
+    assert not tc.applies(_Model(transformer = object()), 50, 0.12)
+
