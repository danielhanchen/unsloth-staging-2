+
+class _TeaCacheRuntime(FakeRuntime):
+    def generate(
+        self,
+        model,
+        *,
+        teacache_threshold = None,
+        **kwargs,
+    ):
+        self.teacache = teacache_threshold
+        self.last_teacache = (
+            {"skipped": 3, "computed": kwargs["steps"] - 3} if teacache_threshold else None
+        )
+        return super().generate(model, **kwargs)
+
+
+def test_teacache_is_opt_in_and_reaches_only_the_runs_it_applies_to(env, monkeypatch):
+    backend, _runtime, _calls = env
+    runtime = _TeaCacheRuntime()
+    backend.runtime_factory = lambda: runtime
+    backend._runtime = None
+    monkeypatch.delenv("UNSLOTH_DIFFUSION_MLX_TEACACHE", raising = False)
+    assert _load(backend, transformer_cache = "fbcache")["phase"] == "ready"
+    assert backend._state.teacache_threshold == mb.teacache.DEFAULT_THRESHOLD
+    assert backend.status()["transformer_cache"] == "teacache"
+    applies = []
+    monkeypatch.setattr(
+        mb.teacache,
+        "applies",
+        lambda model, steps, thr: applies.append((steps, thr)) or steps >= 20,
+    )
+    out = backend.generate(prompt = "p", width = 256, height = 256, steps = 30, seed = 1)
+    assert runtime.teacache == mb.teacache.DEFAULT_THRESHOLD
+    assert out["transformer_cache"] == "teacache"
+    assert backend.last_timings["images"][0]["teacache_skipped"] == 3
+    out = backend.generate(prompt = "p", width = 256, height = 256, steps = 8, seed = 1)
+    assert runtime.teacache is None
+    assert out["transformer_cache"] is None
+    assert applies == [(30, 0.12), (8, 0.12)]
+
+
+def test_teacache_stays_off_without_the_opt_in(env, monkeypatch):
+    backend, runtime, _calls = env
+    monkeypatch.delenv("UNSLOTH_DIFFUSION_MLX_TEACACHE", raising = False)
+    assert _load(backend)["phase"] == "ready"
+    assert backend._state.teacache_threshold is None
+    assert backend.status()["transformer_cache"] is None
+    out = backend.generate(prompt = "p", width = 256, height = 256, steps = 30, seed = 1)
+    assert out["transformer_cache"] is None
