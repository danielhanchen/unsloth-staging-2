+"""CPU checks of the MPS Qwen-Image-2.1 block: row-level modulation / residual are bit-identical to diffusers, the
+Metal kernels' arithmetic (emulated in torch) matches the stock ops, and nothing installs off MPS."""
+
+from types import SimpleNamespace
+
+import pytest
+
+torch = pytest.importorskip("torch")
+qmod = pytest.importorskip("diffusers.models.transformers.transformer_qwenimage21")
+
+from core.inference import diffusion_qwenimage21_mps as mps  # noqa: E402
+
+
+def _bf(x):
+    return x.to(torch.bfloat16).float()
+
+
+def _emulated_residual(h, y, gate_rows, p, zero_row):
+    """The q21_gated_residual kernel's arithmetic: bf16(h + bf16(gate[row] * y))."""
+    batch, seq, dim = h.shape
+    rows = torch.arange(seq) < p
+    g = torch.where(rows.view(1, -1, 1), gate_rows[zero_row].float(), gate_rows[:batch].float().unsqueeze(1))
+    return (h.float() + _bf(g * y.float())).to(torch.bfloat16)
+
+
+def _emulated_norm_rope(x, weight, eps, freqs):
+    """The q21_qk_norm_rope kernel's arithmetic, pairwise fp32 sum of squares."""
+    xf = x.float()
+    pairs = xf.unflatten(-1, (-1, 2))
+    ss = (pairs[..., 0] * pairs[..., 0] + pairs[..., 1] * pairs[..., 1]).sum(-1, keepdim = True)
+    r = torch.rsqrt(ss / x.shape[-1] + eps)
+    n = _bf(_bf(xf * r) * weight.float()).unflatten(-1, (-1, 2))
+    fr = freqs.real[None, :, None, :]
+    fi = freqs.imag[None, :, None, :]
+    a, c = n[..., 0], n[..., 1]
+    return torch.stack([a * fr - c * fi, a * fi + c * fr], dim = -1).flatten(-2).to(torch.bfloat16)
+
+
+@pytest.mark.parametrize("p", [0, 1, 7, 40])
+def test_prefix_len_reads_split_masks(p):
+    mask = torch.arange(40) >= p
+    assert mps.prefix_len(mask, 40) == p
+    assert mps.prefix_len(mask, 41) is None
+
+
+def test_prefix_len_rejects_interleaved_mask():
+    mask = torch.ones(16, dtype = torch.bool)
+    mask[:3] = False
+    mask[9] = False
+    assert mps.prefix_len(mask, 16) is None
+    assert mps.prefix_len(mask.float(), 16) is None
+
+
+def test_prefix_len_rereads_after_in_place_write():
+    mask = torch.arange(12) >= 4
+    assert mps.prefix_len(mask, 12) == 4
+    mask[:6] = False
+    assert mps.prefix_len(mask, 12) == 6
+
+
+def _block_case(batch, seq, dim, p, seed):
+    g = torch.Generator().manual_seed(seed)
+    x = torch.randn(batch, seq, dim, generator = g).to(torch.bfloat16)
+    y = torch.randn(batch, seq, dim, generator = g).to(torch.bfloat16)
+    masked = p is not None
+    rows = torch.randn(batch + (1 if masked else 0), 2 * dim, generator = g).to(torch.bfloat16)
+    mask = (torch.arange(seq) >= p) if masked else None
+    return x, y, rows, mask
+
+
+@pytest.mark.parametrize("batch,p", [(1, None), (1, 0), (1, 5), (2, 5), (2, None), (1, 33)])
+def test_modulate_bit_identical_to_diffusers(batch, p):
+    x, _, rows, mask = _block_case(batch, 33, 64, p, 3)
+    block = SimpleNamespace()
+    want, want_gate = qmod.QwenImage21TransformerBlock._modulate(block, x, rows, mask)
+    scale, gate = rows.chunk(2, dim = -1)
+    got = mps.modulate(x, 1 + scale, mask is not None, p or 0)
+    assert torch.equal(got, want)
+
+
+@pytest.mark.parametrize("batch,p", [(1, None), (1, 0), (1, 5), (2, 5), (2, None), (1, 33)])
+def test_residual_split_bit_identical_to_diffusers(batch, p):
+    h, y, rows, mask = _block_case(batch, 33, 64, p, 4)
+    _, gate = rows.chunk(2, dim = -1)
+    want = h + qmod._select_modulation_rows(gate, mask).tanh() * y
+    got = mps.gated_residual(h, y, gate.tanh().contiguous(), mask is not None, p or 0, metal = False)
+    assert torch.equal(got, want)
+
+
+@pytest.mark.parametrize("batch,p", [(1, None), (1, 0), (1, 5), (2, 9)])
+def test_residual_kernel_arithmetic_matches_diffusers(batch, p):
+    h, y, rows, mask = _block_case(batch, 33, 256, p, 5)
+    _, gate = rows.chunk(2, dim = -1)
+    tg = gate.tanh().contiguous()
+    want = h + qmod._select_modulation_rows(gate, mask).tanh() * y
+    got = _emulated_residual(h, y, tg, p or 0, tg.shape[0] - 1)
+    assert torch.equal(got, want)
+
+
+@pytest.mark.parametrize("seed", [0, 1, 2])
+def test_norm_rope_kernel_arithmetic_within_one_bf16_step(seed):
+    from diffusers.models.normalization import RMSNorm
+
+    g = torch.Generator().manual_seed(seed)
+    x = (3 * torch.randn(1, 64, 4, 128, generator = g)).to(torch.bfloat16)
+    norm = RMSNorm(128, eps = 1e-6).to(torch.bfloat16)
+    with torch.no_grad():
+        norm.weight.copy_(1 + 0.2 * torch.randn(128, generator = g))
+    angles = 50 * torch.randn(64, 64, generator = g)
+    freqs = torch.polar(torch.ones_like(angles), angles)
+    with torch.no_grad():
+        want = qmod.apply_rotary_emb_qwen(norm(x).to(x.dtype), freqs, use_real = False)
+    got = _emulated_norm_rope(x, norm.weight, norm.eps, freqs)
+    diff = (got.float() - want.float()).abs()
+    assert bool((diff <= want.float().abs() * 2**-7 + 1e-6).all())
+    # the sum-of-squares order is the only difference: nearly every element is bit-equal
+    assert (diff == 0).float().mean() > 0.97
+
+
+def _blocks(n = 2, dim = 64, heads = 2):
+    torch.manual_seed(0)
+    return [
+        qmod.QwenImage21TransformerBlock(dim, heads, dim // heads).to(torch.bfloat16).eval()
+        for _ in range(n)
+    ]
+
+
+class QwenImage21Transformer2DModel:
+    def __init__(self, blocks):
+        self.transformer_blocks = blocks
+
+    def parameters(self):
+        return self.transformer_blocks[0].parameters()
+
+
+def _pipe(blocks):
+    return SimpleNamespace(transformer = QwenImage21Transformer2DModel(blocks))
+
+
+def _run_blocks(blocks, x, modulation, mask, freqs):
+    with torch.no_grad():
+        for b in blocks:
+            x = b(hidden_states = x, modulation = modulation, rotary_emb = freqs, target_token_mask = mask)
+    return x
+
+
+@pytest.mark.parametrize("p", [None, 0, 6])
+def test_block_forward_bit_identical_on_eager_paths(monkeypatch, p):
+    """With the device gate opened on CPU, the block (row modulation + split residual, stock RoPE) equals diffusers."""
+    monkeypatch.setattr(mps, "_device_ok", lambda x: True)
+    monkeypatch.setattr(mps, "_library", lambda: None)
+    mps._PROBED.clear()
+    blocks = _blocks()
+    g = torch.Generator().manual_seed(9)
+    seq, dim = 20, 64
+    x = torch.randn(1, seq, dim, generator = g).to(torch.bfloat16)
+    masked = p is not None
+    modulation = torch.randn(1 + (1 if masked else 0), 4 * dim, generator = g).to(torch.bfloat16)
+    mask = (torch.arange(seq) >= p) if masked else None
+    angles = torch.randn(seq, dim // 4, generator = g)
+    freqs = torch.polar(torch.ones_like(angles), angles)
+    want = _run_blocks(blocks, x, modulation, mask, freqs)
+
+    pipe = _pipe(blocks)
+    assert mps.install_for_pipe(pipe)
+    before = dict(mps.STATS)
+    got = _run_blocks(blocks, x, modulation, mask, freqs)
+    assert mps.STATS["block"] - before["block"] == len(blocks)
+    if p:
+        assert mps.STATS["mod_split"] > before["mod_split"]
+        assert mps.STATS["residual_split"] > before["residual_split"]
+    assert torch.equal(got, want)
+    mps.uninstall(pipe.transformer)
+    assert all("forward" not in b.__dict__ for b in blocks)
+    mps._PROBED.clear()
+
+
+def test_install_declines_off_mps_and_leaves_blocks_untouched():
+    blocks = _blocks(1)
+    pipe = _pipe(blocks)
+    assert not mps.install_for_pipe(pipe)
+    assert "forward" not in blocks[0].__dict__
+    assert mps.PREPARE_ATTR not in blocks[0].attn.__dict__
+
+
+def test_explicit_off_and_kill_switch_uninstall(monkeypatch):
+    monkeypatch.setattr(mps, "_device_ok", lambda x: True)
+    blocks = _blocks(1)
+    pipe = _pipe(blocks)
+    assert mps.install_for_pipe(pipe)
+    assert mps.PREPARE_ATTR in blocks[0].attn.__dict__
+    assert not mps.install_for_pipe(pipe, explicit_off = True)
+    assert "forward" not in blocks[0].__dict__
+    assert mps.install_for_pipe(pipe)
+    monkeypatch.setenv(mps.FUSED_ENV, "0")
+    assert not mps.install_for_pipe(pipe)
+    assert "forward" not in blocks[0].__dict__
+
+
+def test_install_skips_a_block_another_hook_wraps(monkeypatch):
+    monkeypatch.setattr(mps, "_device_ok", lambda x: True)
+    blocks = _blocks(2)
+    hook = lambda *a, **k: None  # noqa: E731
+    blocks[0].__dict__["forward"] = hook
+    pipe = _pipe(blocks)
+    assert mps.install_for_pipe(pipe)
+    assert blocks[0].__dict__["forward"] is hook
+    assert getattr(blocks[1].__dict__["forward"], "__unsloth_q21_mps__", False)
+    mps.uninstall(pipe.transformer)
+    assert blocks[0].__dict__["forward"] is hook
+
+
+def test_part_switches(monkeypatch):
+    monkeypatch.setattr(mps, "_device_ok", lambda x: True)
+    monkeypatch.setenv("UNSLOTH_DIFFUSION_Q21_MPS_ROPE", "0")
+    monkeypatch.setenv("UNSLOTH_DIFFUSION_Q21_MPS_RESIDUAL", "0")
+    blocks = _blocks(1)
+    pipe = _pipe(blocks)
+    assert mps.install_for_pipe(pipe)
+    assert mps.PREPARE_ATTR not in blocks[0].attn.__dict__
+    assert blocks[0].__dict__[mps._BLOCK_ATTR] == (True, False)
+    mps.uninstall(pipe.transformer)
+
+
+def test_fingerprints_match_pinned_diffusers():
+    assert mps.why_unsupported(qmod) is None
+
+
+def test_bounded_processor_uses_the_stock_prepare_without_the_attribute():
+    from core.inference import diffusion_qwenimage21_math as bounded
+    import inspect
+
+    src = inspect.getsource(bounded._processor_class)
+    assert '__dict__.get("_unsloth_q21_mps_prepare") or _qwenimage21_prepare_qkv' in src
+    assert mps.PREPARE_ATTR == "_unsloth_q21_mps_prepare"
