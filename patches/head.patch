+def test_gate_skips_slow_change_and_never_the_first_or_last_step():
+    mx = _mx()
+    gate = tc._Gate(0.12, 10)
+    base = mx.ones((1, 8, 4))
+    decisions = []
+    for i in range(10):
+        compute = gate.decide(mx, base * (1.0 + 0.03 * i))
+        if compute and gate.update:
+            gate.residual = gate.residual_neg = base
+        decisions.append(compute)
+    assert decisions[0] and decisions[-1]
+    assert not all(decisions)
+    # A big jump always computes.
+    gate = tc._Gate(0.12, 10)
+    for i in range(10):
+        compute = gate.decide(mx, base * (10.0**i))
+        if compute and gate.update:
+            gate.residual = base
+        assert compute
