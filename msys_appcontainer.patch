+	      && ((PTOKEN_APPCONTAINER_INFORMATION) info)->TokenAppContainer)
+	    ok = NT_SUCCESS (RtlAddAccessAllowedAce (dacl, ACL_REVISION,
+			  GENERIC_ALL,
+			  ((PTOKEN_APPCONTAINER_INFORMATION) info)->TokenAppContainer));
