+/* An AppContainer process may not create objects in the global
+   \BaseNamedObjects or \Sessions\BNOLINKS directories.  The Win32
+   named-object APIs redirect it to its own directory, but absolute NT paths
+   are not redirected, so build the path of that directory here.  Returns
+   false outside an AppContainer. */
+static bool
+appcontainer_object_dir (PWCHAR buf, ULONG session_id)
+{
+  HANDLE tok;
+  ULONG is_ac = 0, size;
+  bool ret = false;
+
+  if (!NT_SUCCESS (NtOpenProcessToken (NtCurrentProcess (), TOKEN_QUERY,
+				       &tok)))
+    return false;
+  if (NT_SUCCESS (NtQueryInformationToken (tok, TokenIsAppContainer, &is_ac,
+					   sizeof is_ac, &size)) && is_ac)
+    {
+      BYTE info[sizeof (TOKEN_APPCONTAINER_INFORMATION) + SECURITY_MAX_SID_SIZE];
+      if (NT_SUCCESS (NtQueryInformationToken (tok, TokenAppContainerSid, info,
+					       sizeof info, &size)))
+	{
+	  PSID sid = ((PTOKEN_APPCONTAINER_INFORMATION) info)->TokenAppContainer;
+	  WCHAR sidstr[256];
+	  UNICODE_STRING usid;
+
+	  RtlInitEmptyUnicodeString (&usid, sidstr, sizeof sidstr);
+	  if (sid && NT_SUCCESS (RtlConvertSidToUnicodeString (&usid, sid,
+							      FALSE)))
+	    {
+	      __small_swprintf (buf,
+				L"\\Sessions\\%u\\AppContainerNamedObjects\\%S",
+				session_id, &usid);
+	      ret = true;
+	    }
+	}
+    }
+  NtClose (tok);
+  return ret;
+}
+
+/* True when this process runs in an AppContainer.  Its access checks also
+   need the AppContainer side of a DACL granted, see sec_acl. */
+bool
+in_appcontainer ()
+{
+  static NO_COPY int cached = -1;
+
+  if (cached < 0)
+    {
+      HANDLE tok;
+      ULONG is_ac = 0, size;
+
+      cached = 0;
+      if (NT_SUCCESS (NtOpenProcessToken (NtCurrentProcess (), TOKEN_QUERY,
+					  &tok)))
+	{
+	  if (NT_SUCCESS (NtQueryInformationToken (tok, TokenIsAppContainer,
+						   &is_ac, sizeof is_ac,
+						   &size)))
+	    cached = is_ac ? 1 : 0;
+	  NtClose (tok);
+	}
+    }
+  return cached == 1;
+}
+
+static ULONG
+current_session_id ()
+{
+  PROCESS_SESSION_INFORMATION psi;
+
+  if (!NT_SUCCESS (NtQueryInformationProcess (NtCurrentProcess (),
+					      ProcessSessionInformation,
+					      &psi, sizeof psi, NULL)))
+    return 0;
+  return psi.SessionId;
+}
+
+/* Named pipes follow the same rule: an AppContainer may only create them
+   below its own prefix of the named pipe file system, which Win32 spells
+   \\.\pipe\LOCAL\.  Returns that prefix relative to \Device\NamedPipe\,
+   with a trailing backslash, or an empty string outside an AppContainer. */
+PCWSTR
+appcontainer_pipe_prefix ()
+{
+  static NO_COPY WCHAR prefix[MAX_PATH];
+  static NO_COPY bool done;
+
+  if (!done)
+    {
+      WCHAR acdir[MAX_PATH];
+      /* acdir is \Sessions\N\AppContainerNamedObjects\SID; drop the
+	 leading backslash to make it relative to the NPFS root. */
+      if (appcontainer_object_dir (acdir, current_session_id ()))
+	__small_swprintf (prefix, L"%W\\", acdir + 1);
+      else
+	prefix[0] = L'\0';
+      done = true;
+    }
+  return prefix;
+}
+
+#ifndef PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY
+#define PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY 0x00020007
+#endif
+#define MITIGATION_BOTTOM_UP_ASLR_ALWAYS_OFF	(0x00000002ULL << 16)
+#define MITIGATION_HIGH_ENTROPY_ASLR_ALWAYS_OFF	(0x00000002ULL << 20)
+
+/* An AppContainer process runs with bottom-up and high-entropy ASLR forced
+   on, and so do the children it creates.  A randomized allocation made by
+   the loader can then land in the child's fixed cygheap range and the fork
+   or exec fails with "cygheap read copy failed".  Ask for those two
+   policies off in the child; fall back to a plain CreateProcessW if the
+   system refuses the attribute. */
+BOOL
+create_process_fixed_layout (LPCWSTR app, LPWSTR cmd,
+			     LPSECURITY_ATTRIBUTES psa,
+			     LPSECURITY_ATTRIBUTES tsa, BOOL inherit,
+			     DWORD flags, LPVOID env, LPCWSTR cwd,
+			     LPSTARTUPINFOW si, LPPROCESS_INFORMATION pi)
+{
+  if (in_appcontainer ())
+    {
+      SIZE_T size = 0;
+      InitializeProcThreadAttributeList (NULL, 1, 0, &size);
+      PPROC_THREAD_ATTRIBUTE_LIST attr
+	= (PPROC_THREAD_ATTRIBUTE_LIST) alloca (size);
+      DWORD64 policy = MITIGATION_BOTTOM_UP_ASLR_ALWAYS_OFF
+		       | MITIGATION_HIGH_ENTROPY_ASLR_ALWAYS_OFF;
+      if (InitializeProcThreadAttributeList (attr, 1, 0, &size))
+	{
+	  BOOL ret = FALSE;
+	  if (UpdateProcThreadAttribute (attr, 0,
+					 PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY,
+					 &policy, sizeof policy, NULL, NULL))
+	    {
+	      STARTUPINFOEXW six;
+	      memset (&six, 0, sizeof six);
+	      six.StartupInfo = *si;
+	      six.StartupInfo.cb = sizeof six;
+	      six.lpAttributeList = attr;
+	      ret = CreateProcessW (app, cmd, psa, tsa, inherit,
+				    flags | EXTENDED_STARTUPINFO_PRESENT,
+				    env, cwd, &six.StartupInfo, pi);
+	      if (!ret)
+		debug_printf ("CreateProcessW with ASLR attribute, %E");
+	    }
+	  DeleteProcThreadAttributeList (attr);
+	  if (ret)
+	    return ret;
+	}
+    }
+  return CreateProcessW (app, cmd, psa, tsa, inherit, flags, env, cwd, si,
+			 pi);
+}
+
+/* The root process of a tree is created by whoever launched it, so inside
+   an AppContainer it keeps high-entropy ASLR and its fixed cygheap range
+   can already be taken.  Run the same command again as a child created by
+   create_process_fixed_layout, pass the standard handles through, and exit
+   with its status.  Returns only if that is not possible. */
+void
+relaunch_with_fixed_layout ()
+{
+  typedef BOOL (WINAPI *gpmp_t) (HANDLE, int, PVOID, SIZE_T);
+  gpmp_t gpmp = (gpmp_t) (void *)
+    GetProcAddress (GetModuleHandleW (L"kernel32.dll"),
+		    "GetProcessMitigationPolicy");
+  DWORD aslr = 0;
+  /* ProcessASLRPolicy is 1; bit 2 is EnableHighEntropy.  Without it the
+     relaunched child would hit the same collision, so do not loop. */
+  if (!in_appcontainer () || !gpmp
+      || !gpmp (GetCurrentProcess (), 1, &aslr, sizeof aslr)
+      || !(aslr & 4))
+    return;
+
+  PCWSTR cl = GetCommandLineW ();
+  SIZE_T len = (wcslen (cl) + 1) * sizeof (WCHAR);
+  PWCHAR cmd = (PWCHAR) HeapAlloc (GetProcessHeap (), 0, len);
+  PWCHAR app = (PWCHAR) HeapAlloc (GetProcessHeap (), 0,
+				   NT_MAX_PATH * sizeof (WCHAR));
+  if (!cmd || !app || !GetModuleFileNameW (NULL, app, NT_MAX_PATH))
+    return;
+  memcpy (cmd, cl, len);
+
+  STARTUPINFOW si;
+  memset (&si, 0, sizeof si);
+  si.cb = sizeof si;
+  si.dwFlags = STARTF_USESTDHANDLES;
+  si.hStdInput = GetStdHandle (STD_INPUT_HANDLE);
+  si.hStdOutput = GetStdHandle (STD_OUTPUT_HANDLE);
+  si.hStdError = GetStdHandle (STD_ERROR_HANDLE);
+  PROCESS_INFORMATION pi;
+  if (!create_process_fixed_layout (app, cmd, NULL, NULL, TRUE,
+				    CREATE_UNICODE_ENVIRONMENT, NULL, NULL,
+				    &si, &pi))
+    return;
+  CloseHandle (pi.hThread);
+  WaitForSingleObject (pi.hProcess, INFINITE);
+  DWORD code = 1;
+  GetExitCodeProcess (pi.hProcess, &code);
+  ExitProcess (code);
+}
