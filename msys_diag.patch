index 0010a17..819e390 100644
--- a/winsup/cygwin/strace.cc
+++ b/winsup/cygwin/strace.cc
@@ -20,6 +20,84 @@ details. */
 #include "child_info.h"
 #include "sync.h"
 
+/* DIAGNOSTIC ONLY: append to %MSYS_DIAG_LOG% so messages from processes
+   without a usable stderr (forked children) are not lost. */
+extern "C" void
+msys_diag_write (const char *buf, int len)
+{
+  WCHAR path[MAX_PATH];
+  DWORD n = GetEnvironmentVariableW (L"MSYS_DIAG_LOG", path, MAX_PATH);
+  if (!n || n >= MAX_PATH)
+    return;
+  HANDLE h = CreateFileW (path, FILE_APPEND_DATA, FILE_SHARE_READ
+			  | FILE_SHARE_WRITE, NULL, OPEN_ALWAYS, 0, NULL);
+  if (h == INVALID_HANDLE_VALUE)
+    return;
+  char pre[64];
+  DWORD done;
+  int m = __small_sprintf (pre, "[winpid %u] ", GetCurrentProcessId ());
+  WriteFile (h, pre, m, &done, NULL);
+  WriteFile (h, buf, len, &done, NULL);
+  WriteFile (h, "\n", 1, &done, NULL);
+  CloseHandle (h);
+}
+
+extern "C" void
+msys_diag_note (const char *what)
+{
+  char b[256];
+  int n = __small_sprintf (b, "note %s err=%u base=%p", what, GetLastError (),
+			   GetModuleHandleW (L"msys-2.0.dll"));
+  msys_diag_write (b, n);
+}
+
+static LONG CALLBACK
+msys_diag_veh (PEXCEPTION_POINTERS ep)
+{
+  static LONG seen;
+  if (InterlockedIncrement (&seen) > 40)
+    return EXCEPTION_CONTINUE_SEARCH;
+  char b[256];
+  PEXCEPTION_RECORD er = ep->ExceptionRecord;
+  int n = __small_sprintf (b, "exception %y at %p base=%p info0=%p info1=%p",
+			   er->ExceptionCode, er->ExceptionAddress,
+			   GetModuleHandleW (L"msys-2.0.dll"),
+			   (void *) (er->NumberParameters > 0 ? er->ExceptionInformation[0] : 0),
+			   (void *) (er->NumberParameters > 1 ? er->ExceptionInformation[1] : 0));
+  msys_diag_write (b, n);
+  return EXCEPTION_CONTINUE_SEARCH;
+}
+
+extern "C" void
+msys_diag_start ()
+{
+  if (!GetEnvironmentVariableW (L"MSYS_DIAG_LOG", NULL, 0))
+    return;
+  AddVectoredExceptionHandler (1, msys_diag_veh);
+  /* Raw DWORD policies: 1 ASLR, 2 dynamic code, 3 strict handle check,
+     4 system call disable, 10 image load. */
+  typedef BOOL (WINAPI *gpmp_t) (HANDLE, int, PVOID, SIZE_T);
+  gpmp_t gpmp = (gpmp_t) (void *) GetProcAddress (GetModuleHandleW (L"kernel32.dll"),
+					 "GetProcessMitigationPolicy");
+  DWORD aslr = 0, dyn = 0, sh = 0, sc = 0, il = 0;
+  if (gpmp)
+    {
+      gpmp (GetCurrentProcess (), 1, &aslr, sizeof aslr);
+      gpmp (GetCurrentProcess (), 2, &dyn, sizeof dyn);
+      gpmp (GetCurrentProcess (), 3, &sh, sizeof sh);
+      gpmp (GetCurrentProcess (), 4, &sc, sizeof sc);
+      gpmp (GetCurrentProcess (), 10, &il, sizeof il);
+    }
+  STARTUPINFOW si;
+  GetStartupInfoW (&si);
+  char b[256];
+  int n = __small_sprintf (b, "policies aslr=%y dyncode=%y stricthandle=%y "
+			   "syscalldisable=%y imageload=%y cbReserved2=%u flags=%y",
+			   aslr, dyn, sh, sc, il,
+			   si.cbReserved2, si.dwFlags);
+  msys_diag_write (b, n);
+}
